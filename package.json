{
  "name": "momentum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "backend": "pnpm --filter @momentum/backend start",
    "dev": "node scripts/dev.mjs",
    "momentum": "pnpm --filter @momentum/backend cli",
    "e2e": "pnpm --filter @momentum/backend e2e",
    "e2e:runner": "pnpm --filter @momentum/backend e2e:runner",
    "deck": "pnpm --filter @momentum/docs deck",
    "video": "pnpm --filter @momentum/video music && pnpm --filter @momentum/video render Momentum out/momentum.mp4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
